# Obsidian 运行时状态，不进模板
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 同步插件的本地状态与哈希缓存（由插件运行时生成）
.obsidian/plugins/fast-note-sync/*HashMap.json
.obsidian/plugins/fast-note-sync/folderSnapshot.json
.obsidian/plugins/fast-note-sync/temp-chunks/
.obsidian/plugins/fast-note-sync/debug/

# i18n 插件的翻译备份缓存
.obsidian/plugins/obsidian-i18n/backups/

# 系统与回收站
.trash/
.DS_Store
Thumbs.db
desktop.ini
